# 复制为 .env 后填写（docker-compose 会自动读取同目录下的 .env）
# 务必修改下面两项，不要用默认值！

# MySQL root 密码（同时作为应用连接密码）
DB_PASSWORD=change-me-strong-password
DB_NAME=christian_platform

# JWT 签名密钥：请生成一段足够长的随机串，例如:
#   openssl rand -base64 48
JWT_SECRET=please-set-a-long-random-secret

# 你的域名（网页主域；未单独指定时也作为推流/播放主机）
DOMAIN=amen.dpdns.org

# ---- 直播(MediaMTX)可选覆盖 ----
# 主播推流主机。RTMP 是裸 TCP，Cloudflare 只代理 HTTP(S)，
# 所以主域一旦开橙云，这里必须换成「灰云(DNS only)」子域，否则 OBS 连不上。
# MEDIAMTX_PUBLIC_HOST=push.amen.dpdns.org
#
# 观众播放主机。走 HTTPS 443 的 /hls/，由 nginx 反代，可用橙云主域。
# 推流主机与它不同时必须显式设置，否则播放地址落到灰云域名上会证书不匹配 → 黑屏。
# MEDIAMTX_HLS_HOST=amen.dpdns.org
# 控制 API 凭证。MediaMTX 镜像默认 admin/admin，与应用代码默认值一致；
# 若改了这里，需同步改 .env 里 MEDIAMTX_USER/MEDIAMTX_PASS 保持一致。
# MEDIAMTX_USER=admin
# MEDIAMTX_PASS=admin