.next-verify.*
.next-navdev/
out/
build_output.txt
.build-trash/
.build.log
prod.log
*.log

# TypeScript 增量缓存
*.tsbuildinfo

# ===== 环境变量与密钥（绝不能提交）=====
.env
.env.local
.env.*.local
.env.production

# ===== 运行时上传数据（仅根级目录，避免误伤 src/app/media 等源码）=====
/uploads/
/data/
/_deploy_env_backup/

# 数据库备份产物
/backups/

# 用户上传的媒体文件：属运行时数据，不入库（保留目录占位）
/public/uploads/
!/public/uploads/.gitkeep

# ===== 编辑器与系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== 临时文件 =====
