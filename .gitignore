# ===== 依赖与构建产物 =====
node_modules/
.next/
.next.*
.next-*/
.next-verify/
.next-verify.*
.next-navdev/
.next-i18n/
out/
build_output.txt
.build-trash/
.build.log
prod.log
*.log

# TypeScript 增量缓存
*.tsbuildinfo

# ===== 环境变量与密钥（绝不能提交）=====
.env
.env.local
.env.*.local
.env.production

# ===== 运行时上传数据（仅根级目录，避免误伤 src/app/media 等源码）=====
/uploads/
# 静态种子数据（和合本经文）属源码，必须入库；其余运行时数据不入库。
# 用 /data/* 而非 /data/：git 不会进入已排除的目录，写 /data/ 时下面的例外行无效。
/data/*
!/data/bible-verses.json
/_deploy_env_backup/

# 数据库备份产物
/backups/

# 用户上传的媒体文件：属运行时数据，不入库（保留目录占位）
/public/uploads/
!/public/uploads/.gitkeep

# ===== 编辑器与系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== 临时文件 =====
# 注意：绝不使用裸 `_*`，会误伤 src/app/admin/_components.tsx 等源码
*.tmp
*.pma
/_shots/
/_aud2/

# 无头浏览器用户数据目录（手机端审计用，体积大）
.chrome-test/
_chromeprof*/
_shots/
_shots-*/
*.corrupt-*/
_chromeprof*/
_shots/
_shots-*/
*.corrupt-*/
.scanbuild/
/_aud3/
